services:

# nginx:
#   image: nginx:1.25
#   ports:
#     - "80:80"
#     - "443:443"
#   volumes:
#     - ./data/nginx:/etc/nginx/conf.d
#     - ./data/local:/var/www/local
#   depends_on:
#     - backend
#   restart: always
#   command: "/bin/sh -c 'while :; do sleep 6h & wait $${!}; nginx -s reload; done & nginx -g \"daemon off;\"'"

  backend:
    build: esp-crash-server
    restart: always
    # Toolchain packages are built by esp-crash-server/toolchains/recipes/ and
    # mounted read-only, never baked into the image. Build one with:
    #   ./esp-crash-server/toolchains/recipes/xtensa-esp.sh --out /opt/esp-crash-toolchains
    # The web app reads their descriptors for the settings dropdown and to
    # decide whether to offer the Debug link, so it needs the mount too.
    volumes:
      - /opt/esp-crash-toolchains:/opt/toolchains:ro
    secrets:
      - db-password
    ports:
      - 8000:8000
    depends_on:
      - postgres
    environment:
      EXTERNAL_URL: "https://esp-crash.wennlund.nu"
      APP_SECRET_KEY: aaaaaaaaaaaaaaaaaaaa
      GITHUB_OAUTH_CLIENT_ID: aaaaaaaaaaaaaaaaaaaa
      GITHUB_OAUTH_CLIENT_SECRET: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
      SLACK_CLIENT_ID: "aaaaaaaaaaaaaaaaaaa"
      SLACK_CLIENT_SECRET: "aaaaaaaaaaaaaaaaaaaaaaa"
      POSTGRES_HOST: postgres
      POSTGRES_USER: esp-crash
      POSTGRES_PASSWORD: xxxxx
      POSTGRES_DB: esp-crash
      # Interactive in-browser gdb sessions. Both must be set for the Debug
      # link to appear on a crash page; leave them empty to keep the feature
      # off. GDB_TICKET_SECRET must match the gdb service's value, and is
      # deliberately separate from APP_SECRET_KEY so the debug service never
      # needs the session-cookie key.
      GDB_TICKET_SECRET: aaaaaaaaaaaaaaaaaaaa
      GDB_PUBLIC_WS_URL: "wss://gdb-esp-crash.wennlund.nu/v1/session"

  cron:
    build: esp-crash-server
    restart: always
    command: python cron_runner.py
    environment:
      # Decoding happens in the sandboxed debug service; this image has neither
      # a toolchain nor esp-coredump. Without these, cron logs an error and
      # leaves pending crashes alone rather than storing anything.
      DECODE_SERVICE_URL: "http://esp-crash-gdb:8002"
      DECODE_SERVICE_TOKEN: aaaaaaaaaaaaaaaaaaaa
      POSTGRES_HOST: postgres
      POSTGRES_USER: esp-crash
      POSTGRES_PASSWORD: xxxxx
      POSTGRES_DB: esp-crash

  # Sandboxed interactive gdb sessions, one bubblewrap jail per WebSocket.
  # Separate from `backend` for two reasons: gunicorn's synchronous workers
  # cannot serve WebSockets, and this is the only container that needs the
  # relaxed seccomp profile bubblewrap requires.
  esp-crash-gdb:
    build: esp-crash-server
    restart: always
    command: uvicorn gdb_server:app --host 0.0.0.0 --port 8002
    ports:
      - 8002:8002
    depends_on:
      - postgres
    # bubblewrap creates an unprivileged user namespace, which Docker's default
    # seccomp profile blocks (clone/unshare with CLONE_NEWUSER) - it fails with
    # a misleading "the kernel does not allow non-privileged user namespaces"
    # even where the host allows them. The syscall filtering that matters is
    # applied inside the jail; this container runs only our own code.
    security_opt:
      - seccomp=unconfined
    # CAP_SETUID/SETGID to drop into a per-session account, CAP_CHOWN to give
    # that session its work directory, and CAP_SETFCAP because without it
    # bubblewrap cannot write even an identity uid map.
    cap_drop:
      - ALL
    cap_add:
      - SETUID
      - SETGID
      - SETFCAP
      - CHOWN
    # Session work directories: memory-backed, so decompressed crash dumps and
    # ELFs never touch disk and nothing survives a restart.
    tmpfs:
      - /run/gdb:size=2g,mode=0711
    volumes:
      - /opt/esp-crash-toolchains:/opt/toolchains:ro
    # NOTE for the reverse proxy: a WebSocket that has been upgraded is governed
    # by HAProxy's `timeout tunnel`, which falls back to `timeout server` when
    # unset. A short server timeout (30s is a common default) will drop an idle
    # debug session mid-use, so set `timeout tunnel 1h` on this backend.
    environment:
      # Must match the backend's GDB_TICKET_SECRET.
      GDB_TICKET_SECRET: aaaaaaaaaaaaaaaaaaaa
      # Must match cron's DECODE_SERVICE_TOKEN. Grants an unscoped crash read,
      # so it is internal-only: the /v1/decode route is deliberately not served
      # under GDB_PATH_PREFIX and must never be routed through the proxy.
      DECODE_SERVICE_TOKEN: aaaaaaaaaaaaaaaaaaaa
      # Used when a project has no toolchain set, reproducing what the previous
      # in-process decode resolved to for every project.
      GDB_DEFAULT_TOOLCHAIN: "xtensa-esp32"
      # Optional tuning: session limits and the concurrent-session cap (which
      # cannot exceed the number of gdbrun* accounts baked into the image, see
      # the Dockerfile's GDB_SESSION_SLOTS).
      GDB_SESSION_IDLE_SECONDS: "1800"
      GDB_SESSION_MAX_SECONDS: "14400"
      POSTGRES_HOST: postgres
      POSTGRES_USER: esp-crash
      POSTGRES_PASSWORD: xxxxx
      POSTGRES_DB: esp-crash

  postgres:
    image: postgres:15
    restart: always
    shm_size: '2gb'
    environment:
      POSTGRES_USER: esp-crash
      POSTGRES_PASSWORD: crash123
      POSTGRES_DB: esp-crash
    volumes:
      - esp_postgres:/var/lib/postgresql/data/

secrets:
  db-password:
    file: db/password.txt

volumes:
  esp_postgres:

